{
  "name": "zucchini-store",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "vars": {
    "PUBLIC_ORIGIN": "https://store.zucchinifi.xyz",
    "NETWORK": "mainnet",
    "GIFT_CARD_PROVIDER": "cryptorefills",
    "CRYPTOREFILLS_PARTNER_ID": "juoISbgaYd",
    "FUNDING_MODE": "direct_swap",
    "SETTLEMENT_NETWORK": "sol",
    "SETTLEMENT_ASSET": "nep141:sol-5ce3bf3a31af18be40ba30f721101b4341690186.omft.near",
    "SLIPPAGE_BPS": "100",
    "CHECKOUT_ENABLED": "false",
    "FULFILLMENT_ENABLED": "false",
    "SCANNER_READY": "false",
    "MARKUP_BPS": "0",
    "REQUIRED_CONFIRMATIONS": "10",
    "MAX_ORDER_USD": "200",
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 1 * * *"] },
  "routes": [{ "pattern": "store.zucchinifi.xyz", "custom_domain": true }],
}
